      "description": "Move the user's open Facet tab to another page (gallery, persons, albums, stats, ...).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "additionalProperties": {
              "type": [
                "string",
                "integer",
                "number",
                "boolean"
              ]
            },
            "description": "Query-string parameters for the route.",
            "type": "object"
          },
          "route": {
            "description": "Where to go. Edition-only pages (/culling, /junk, /compare, /merge-suggestions) are refused by the tab for other users.",
            "enum": [
              "/",
              "/persons",
              "/merge-suggestions",
              "/compare",
              "/culling",
              "/scenes",
              "/junk",
              "/stats",
              "/albums",
              "/capsules",
              "/folders",
              "/timeline",
              "/map"
            ],
            "type": "string"
          }
        },
        "required": [
          "route"
        ],
        "type": "object"
      },
      "name": "ui_navigate"
    },
